<?xml version="1.0" encoding="utf-8"?>
<!-- The app: one page per tab, the glass tab bar below -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <!-- Зараз -->
        <ScrollView android:id="@+id/page_now" style="@style/Page">
            <LinearLayout style="@style/PageContent">
                <TextView style="@style/PageTitle" android:text="@string/tab_now" />

                <LinearLayout android:id="@+id/card" style="@style/Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/bolt" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="10dp" android:src="@drawable/ic_bolt_on" />
                        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/power_on" android:textColor="@color/text" android:textSize="24sp" android:textStyle="bold" />
                        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
                    </LinearLayout>
                    <TextView android:id="@+id/next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text" android:textSize="16sp" />
                    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_dim" android:textSize="13sp" />
                    <ImageView android:id="@+id/day_bar" android:layout_width="match_parent" android:layout_height="22dp" android:layout_marginTop="14dp" android:scaleType="fitXY" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/WidgetTick" android:gravity="start" android:text="0" />
                        <TextView style="@style/WidgetTick" android:text="6" />
                        <TextView style="@style/WidgetTick" android:text="12" />
                        <TextView style="@style/WidgetTick" android:text="18" />
                        <TextView style="@style/WidgetTick" android:gravity="end" android:text="24" />
                    </LinearLayout>
                    <TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/text_dim" android:textSize="11sp" />
                    <TextView android:id="@+id/error" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFB0B0" android:textSize="12sp" android:visibility="gone" />
                </LinearLayout>

                <LinearLayout android:id="@+id/restricted_card" style="@style/Card" android:layout_marginTop="12dp" android:background="@drawable/glass_card_warn" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/restricted_title" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/restricted_text" android:textColor="@color/text" android:textSize="13sp" />
                    <Button android:id="@+id/open_battery" style="@style/AppButton" android:text="@string/restricted_button" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Графік -->
        <ScrollView android:id="@+id/page_schedule" style="@style/Page" android:visibility="gone">
            <LinearLayout style="@style/PageContent">
                <TextView style="@style/PageTitle" android:text="@string/tab_schedule" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/today" style="@style/AppButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginTop="0dp" android:layout_marginEnd="4dp" android:text="@string/today" />
                    <Button android:id="@+id/tomorrow" style="@style/AppButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginTop="0dp" android:layout_marginStart="4dp" android:text="@string/tomorrow" />
                </LinearLayout>
                <TextView android:id="@+id/no_schedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="28dp" android:textColor="@color/text" android:textSize="15sp" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/column_left" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical" />
                    <LinearLayout android:id="@+id/column_right" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Віджети -->
        <ScrollView android:id="@+id/page_widgets" style="@style/Page" android:visibility="gone">
            <LinearLayout style="@style/PageContent">
                <TextView style="@style/PageTitle" android:text="@string/tab_widgets" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="@string/widgets_hint" android:textColor="@color/text_dim" android:textSize="13sp" />
                <LinearLayout style="@style/Card" android:layout_marginTop="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_small_description" android:textColor="@color/text" android:textSize="14sp" />
                    <Button android:id="@+id/add_small" style="@style/AppButton" android:text="@string/add_small" />
                </LinearLayout>
                <LinearLayout style="@style/Card" android:layout_marginTop="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_strip_description" android:textColor="@color/text" android:textSize="14sp" />
                    <Button android:id="@+id/add_strip" style="@style/AppButton" android:text="@string/add_strip" />
                </LinearLayout>
                <LinearLayout style="@style/Card" android:layout_marginTop="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_day_description" android:textColor="@color/text" android:textSize="14sp" />
                    <Button android:id="@+id/add_day" style="@style/AppButton" android:text="@string/add_day" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Налаштування -->
        <ScrollView android:id="@+id/page_settings" style="@style/Page" android:visibility="gone">
            <LinearLayout style="@style/PageContent">
                <TextView style="@style/PageTitle" android:text="@string/tab_settings" />
                <TextView style="@style/SectionTitle" android:layout_marginTop="4dp" android:text="@string/region" />
                <Spinner android:id="@+id/region" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/spinner_bg" android:paddingHorizontal="12dp" />
                <TextView style="@style/SectionTitle" android:text="@string/group" />
                <Spinner android:id="@+id/group" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/spinner_bg" android:paddingHorizontal="12dp" />
                <Button android:id="@+id/refresh" style="@style/AppButton" android:layout_marginTop="16dp" android:text="@string/refresh" />
                <TextView style="@style/SectionTitle" android:text="@string/background_title" />
                <TextView android:id="@+id/background_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="13sp" />
                <Button android:id="@+id/open_battery_settings" style="@style/AppButton" android:text="@string/restricted_button" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/sources" android:textColor="@color/text_dim" android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/tab_bar_bg"
        android:orientation="horizontal"
        android:padding="5dp">
        <TextView android:id="@+id/tab_schedule" style="@style/Tab" android:text="@string/tab_schedule" />
        <TextView android:id="@+id/tab_now" style="@style/Tab" android:text="@string/tab_now" />
        <TextView android:id="@+id/tab_widgets" style="@style/Tab" android:text="@string/tab_widgets" />
        <TextView android:id="@+id/tab_settings" style="@style/Tab" android:text="@string/tab_settings" />
    </LinearLayout>
</LinearLayout>