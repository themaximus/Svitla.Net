<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="#FF233643" /><stroke android:width="1dp" android:color="#24FFFFFF" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#40FFFFFF" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#FF0C141C" /><stroke android:width="1dp" android:color="#29FFFFFF" /><corners android:radius="10dp" /></shape>
    </item>
</selector>