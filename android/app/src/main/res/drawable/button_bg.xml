<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined pills; filled when selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="#2EFFFFFF" /><stroke android:width="1dp" android:color="#CCFFFFFF" /><corners android:radius="100dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#26FFFFFF" /><stroke android:width="1dp" android:color="#80FFFFFF" /><corners android:radius="100dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#0DFFFFFF" /><stroke android:width="1dp" android:color="#59FFFFFF" /><corners android:radius="100dp" /></shape>
    </item>
</selector>