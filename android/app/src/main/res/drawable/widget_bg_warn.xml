<?xml version="1.0" encoding="utf-8"?>
<!-- The widget during emergency outages, when the power state is not known: amber.
     Glass on the home screen: the launcher draws widgets, so the wallpaper behind cannot be blurred.
     See-through black, glows from above and below, two arcs and a thin edge give the look. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#73000000" /><corners android:radius="24dp" /></shape></item>
    <item><shape android:shape="rectangle">
        <gradient android:type="radial" android:gradientRadius="75%p" android:centerX="0.5" android:centerY="0" android:startColor="#59FF9F1A" android:endColor="#00FF9F1A" />
        <corners android:radius="24dp" />
    </shape></item>
    <item><shape android:shape="rectangle">
        <gradient android:type="radial" android:gradientRadius="75%p" android:centerX="0.5" android:centerY="1" android:startColor="#40FF9F1A" android:endColor="#00FF9F1A" />
        <corners android:radius="24dp" />
    </shape></item>
    <item android:drawable="@drawable/arc_warn" />
    <item><shape android:shape="rectangle">
        <solid android:color="#00000000" />
        <stroke android:width="1dp" android:color="#99FF9F1A" />
        <corners android:radius="24dp" />
    </shape></item>
</layer-list>