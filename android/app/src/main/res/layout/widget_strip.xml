<?xml version="1.0" encoding="utf-8"?>
<!-- Day strip 4×1: the status and today's 48 half hours as one bar with a mark at "now" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_on"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView android:id="@+id/bolt" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_bolt_on" />
        <TextView android:id="@+id/status" style="@style/WidgetStatus" android:textSize="14sp" android:text="@string/power_on" />
        <TextView android:id="@+id/next" style="@style/WidgetNext" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:singleLine="true" />
        <TextView android:id="@+id/label" style="@style/WidgetLabel" android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/schedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <ImageView
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="5dp"
            android:scaleType="fitXY" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView style="@style/WidgetTick" android:gravity="start" android:text="0" />
            <TextView style="@style/WidgetTick" android:text="6" />
            <TextView style="@style/WidgetTick" android:text="12" />
            <TextView style="@style/WidgetTick" android:text="18" />
            <TextView style="@style/WidgetTick" android:gravity="end" android:text="24" />
        </LinearLayout>
    </LinearLayout>

    <!-- Emergency outages: the plaque takes the bar's place -->
    <TextView
        android:id="@+id/emergency_plaque"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/emergency_bg"
        android:gravity="center"
        android:paddingVertical="5dp"
        android:singleLine="true"
        android:text="@string/emergency_plaque"
        android:textColor="@color/text"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>