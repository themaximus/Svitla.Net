<?xml version="1.0" encoding="utf-8"?>
<!-- The round glass button of the bell and the gear -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval"><solid android:color="#2EFFFFFF" /><stroke android:width="1dp" android:color="#CCFFFFFF" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#26FFFFFF" /><stroke android:width="1dp" android:color="#80FFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#0DFFFFFF" /><stroke android:width="1dp" android:color="#40FFFFFF" /></shape>
    </item>
</selector>
