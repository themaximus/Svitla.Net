<?xml version="1.0" encoding="utf-8"?>
<!-- The widget while there is no power: red.
     Glass on the home screen: the launcher draws widgets, so the wallpaper behind cannot be blurred.
     See-through black, glows from above and below and a thin edge give the look. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#73000000" /><corners android:radius="24dp" /></shape></item>
    <item><shape android:shape="rectangle">
        <gradient android:type="radial" android:gradientRadius="75%p" android:centerX="0.5" android:centerY="0" android:startColor="#59FF3B3B" android:endColor="#00FF3B3B" />
        <corners android:radius="24dp" />
    </shape></item>
    <item><shape android:shape="rectangle">
        <gradient android:type="radial" android:gradientRadius="75%p" android:centerX="0.5" android:centerY="1" android:startColor="#40FF3B3B" android:endColor="#00FF3B3B" />
        <corners android:radius="24dp" />
    </shape></item>
    <item><shape android:shape="rectangle">
        <solid android:color="#00000000" />
        <stroke android:width="1dp" android:color="#99FF3B3B" />
        <corners android:radius="24dp" />
    </shape></item>
</layer-list>