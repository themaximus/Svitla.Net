<?xml version="1.0" encoding="utf-8"?>
<!-- The app is the schedule; the bell and the gear in the corner open the notifications and the settings -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">
        <TextView android:id="@+id/title" style="@style/PageTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_marginBottom="0dp" android:singleLine="true" android:text="@string/schedule_title" />
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:visibility="gone" />
        <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
            <ImageView android:id="@+id/open_alerts" style="@style/HeaderIcon" android:contentDescription="@string/alerts_title" android:src="@drawable/ic_bell" />
            <View android:id="@+id/alerts_dot" android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="top|end" android:layout_marginTop="9dp" android:layout_marginEnd="10dp" android:background="@drawable/alert_dot" android:visibility="gone" />
        </FrameLayout>
        <ImageView android:id="@+id/open_settings" style="@style/HeaderIcon" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:contentDescription="@string/settings_title" android:src="@drawable/ic_gear" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <!-- Графік -->
        <ScrollView android:id="@+id/page_schedule" style="@style/Page">
            <LinearLayout style="@style/PageContent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/today" style="@style/AppButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginTop="0dp" android:layout_marginEnd="4dp" android:text="@string/today" />
                    <Button android:id="@+id/tomorrow" style="@style/AppButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginTop="0dp" android:layout_marginStart="4dp" android:text="@string/tomorrow" />
                </LinearLayout>
                <LinearLayout android:id="@+id/emergency_card" style="@style/Card" android:layout_marginTop="12dp" android:background="@drawable/emergency_bg" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/emergency_title" android:textColor="@color/amber" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/emergency_message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/emergency_returns" android:textColor="@color/text_dim" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:id="@+id/no_schedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="28dp" android:textColor="@color/text" android:textSize="15sp" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/column_left" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical" />
                    <LinearLayout android:id="@+id/column_right" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Сповіщення -->
        <ScrollView android:id="@+id/page_alerts" style="@style/Page" android:visibility="gone">
            <LinearLayout style="@style/PageContent">
                <LinearLayout style="@style/Card">
                    <TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="13sp" />
                    <TextView android:id="@+id/background_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/background_ok" android:textColor="@color/text_dim" android:textSize="13sp" />
                    <TextView android:id="@+id/error" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/load_failed" android:textColor="@color/red" android:textSize="13sp" android:visibility="gone" />
                </LinearLayout>
                <LinearLayout android:id="@+id/restricted_card" style="@style/Card" android:layout_marginTop="12dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/restricted_title" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/restricted_text" android:textColor="@color/text" android:textSize="13sp" />
                    <Button android:id="@+id/open_battery" style="@style/AppButton" android:text="@string/restricted_button" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Налаштування -->
        <ScrollView android:id="@+id/page_settings" style="@style/Page" android:visibility="gone">
            <LinearLayout style="@style/PageContent">
                <TextView style="@style/SectionTitle" android:layout_marginTop="4dp" android:text="@string/region" />
                <Spinner android:id="@+id/region" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/spinner_bg" android:paddingHorizontal="12dp" />
                <TextView style="@style/SectionTitle" android:text="@string/group" />
                <Spinner android:id="@+id/group" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/spinner_bg" android:paddingHorizontal="12dp" />
                <Button android:id="@+id/refresh" style="@style/AppButton" android:layout_marginTop="16dp" android:text="@string/refresh" />

                <TextView style="@style/SectionTitle" android:text="@string/widgets_title" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widgets_hint" android:textColor="@color/text_dim" android:textSize="13sp" />
                <LinearLayout style="@style/Card" android:layout_marginTop="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_small_description" android:textColor="@color/text" android:textSize="14sp" />
                    <Button android:id="@+id/add_small" style="@style/AppButton" android:text="@string/add_small" />
                </LinearLayout>
                <LinearLayout style="@style/Card" android:layout_marginTop="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_strip_description" android:textColor="@color/text" android:textSize="14sp" />
                    <Button android:id="@+id/add_strip" style="@style/AppButton" android:text="@string/add_strip" />
                </LinearLayout>
                <LinearLayout style="@style/Card" android:layout_marginTop="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_day_description" android:textColor="@color/text" android:textSize="14sp" />
                    <Button android:id="@+id/add_day" style="@style/AppButton" android:text="@string/add_day" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/sources" android:textColor="@color/text_dim" android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
